@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix gist:    <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix oq:   <https://semantechs.co.uk/ontology-quality/> .

# ---------------------------------------------------------------------------
# DAT-001: Literal lexical form invalid for its datatype (heuristic).
# ---------------------------------------------------------------------------
oq:DAT-001
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT DISTINCT ?this WHERE { ?this ?p ?o . FILTER(isLiteral(?o)) }" ;
  ] ;
  sh:severity sh:Violation ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A literal on {$this} does not match the lexical pattern expected for its datatype." ;
    sh:select """
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this ?path ?value
      WHERE {
        $this ?path ?value .
        FILTER(isLiteral(?value))
        BIND(DATATYPE(?value) AS ?dt)
        # A UNION of FILTER-only branches (no triple pattern of its own in
        # any branch) silently matches nothing under rdflib's SPARQL
        # engine (pyshacl's evaluator), no matter the data -- see
        # sparql/data/DAT-001.rq's identical fix for the isolated repro.
        FILTER(
          (?dt = xsd:date && !REGEX(STR(?value), "^-?[0-9]{4}-[0-9]{2}-[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"))
          || (?dt = xsd:integer && !REGEX(STR(?value), "^[+-]?[0-9]+$"))
          || (?dt = xsd:boolean && !REGEX(STR(?value), "^(true|false|1|0)$"))
        )
      }
    """ ;
  ] .

# ---------------------------------------------------------------------------
# DAT-002: Dangling IRI reference (heuristic).
# ---------------------------------------------------------------------------
oq:DAT-002
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT DISTINCT ?this WHERE { ?this ?p ?o . FILTER(isIRI(?o)) }" ;
  ] ;
  sh:severity sh:Warning ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "{$this} references an IRI ({?value}) that is never used as a subject nor as a class." ;
    sh:select """
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
      PREFIX owl: <http://www.w3.org/2002/07/owl#>
      SELECT $this ?path ?value
      WHERE {
        $this ?path ?value .
        FILTER(isIRI(?value))
        FILTER(?path != rdf:type)
        FILTER(?path != rdfs:seeAlso)
        FILTER NOT EXISTS { ?value ?p2 ?o2 }
        FILTER NOT EXISTS { ?o2b a ?value }
        FILTER(!STRSTARTS(STR(?value), "http://www.w3.org/"))
        FILTER NOT EXISTS { [] owl:versionIRI ?value }
      }
    """ ;
  ] .

# ---------------------------------------------------------------------------
# DAT-003: Duplicate literal values for the same subject/predicate.
# ---------------------------------------------------------------------------
oq:DAT-003
  a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select "SELECT DISTINCT ?this WHERE { ?this ?p ?o . FILTER(isLiteral(?o)) }" ;
  ] ;
  sh:severity sh:Info ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "{$this} has duplicate literal values for property {?path}." ;
    sh:select """
      SELECT $this ?path
      WHERE {
        {
          SELECT $this ?path ?strval (COUNT(?lit) AS ?n)
          WHERE {
            $this ?path ?lit .
            FILTER(isLiteral(?lit))
            BIND(STR(?lit) AS ?strval)
          }
          GROUP BY $this ?path ?strval
          HAVING (COUNT(?lit) > 1)
        }
      }
    """ ;
  ] .

# ---------------------------------------------------------------------------
# DAT-004: gist:Magnitude without a unit of measure.
#
# Native SHACL core, pinned to gist's exact namespace. Two core constraints
# on one property shape carry the whole check:
#
#   sh:minCount 1  -- the magnitude has no unit link at all
#   sh:class       -- it has one, but the target is not a unit
#
# Both subclass walks come free from SHACL's own semantics rather than
# needing a property path: sh:targetClass matches SHACL instances of the
# class, and sh:class tests them, and in both cases "instance of" is
# defined as rdf:type/rdfs:subClassOf* -- so a project subclass of
# gist:Magnitude is still targeted, and a subclass of gist:UnitOfMeasure
# still satisfies the constraint.
#
# Pinning to <https://w3id.org/semanticarts/ns/ontology/gist/> is a
# deliberate choice, and it is narrower than this suite's usual convention
# of matching gist terms by local name (STR-003 does that because gist has
# published under more than one namespace, and because the property itself
# was renamed unitOfMeasure -> hasUnitOfMeasure at gist 12). The cost is
# that a graph built on a pre-12 gist, or on an older gist namespace, is
# not checked at all rather than checked and found wanting. The .rq twin is
# pinned identically on purpose: pinning only one side would make DAT-004's
# findings depend on --engine, and would break the
# (check_id, focus_node, path, value) dedup key so the same finding
# survived twice under --engine both.
# ---------------------------------------------------------------------------
oq:DAT-004
  a sh:NodeShape ;
  rdfs:label "DAT-004: gist:Magnitude without a unit of measure" ;
  sh:targetClass gist:Magnitude ;
  sh:property [
    sh:path gist:hasUnitOfMeasure ;
    sh:minCount 1 ;
    sh:class gist:UnitOfMeasure ;
    sh:severity sh:Violation ;
    sh:message "A gist:Magnitude must have a gist:hasUnitOfMeasure value typed gist:UnitOfMeasure." ;
  ] .

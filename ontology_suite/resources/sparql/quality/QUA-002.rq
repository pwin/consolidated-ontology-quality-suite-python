PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# QUA-002: Ontology missing versioning/title metadata
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Info ;
    sh:focusNode ?o ;
    sh:sourceConstraintComponent oq:QUA-002 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?o a owl:Ontology .
  FILTER NOT EXISTS { ?o owl:versionInfo ?v }
  FILTER NOT EXISTS { ?o dcterms:title ?t }
  FILTER NOT EXISTS { ?o rdfs:label|skos:prefLabel ?l2 }
  BIND(CONCAT("Ontology ", STR(?o),
              " lacks versioning/title metadata (owl:versionInfo, dcterms:title or rdfs:label/skos:prefLabel), ",
              "harming provenance and effectiveness.") AS ?msg)
}

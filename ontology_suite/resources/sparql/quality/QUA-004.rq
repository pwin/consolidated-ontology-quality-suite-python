PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# QUA-004: Resource missing skos:prefLabel (or rdfs:label, treated as an
# equally valid label -- matching QUA-001/QUA-002's own established
# rdfs:label|skos:prefLabel alternation, rather than requiring skos:prefLabel
# specifically).
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Warning ;
    sh:focusNode ?focus ;
    sh:resultPath skos:prefLabel ;
    sh:sourceConstraintComponent oq:QUA-004 ;
    sh:resultMessage ?msg .
}
WHERE {
  {
    SELECT DISTINCT ?focus WHERE {
      { ?focus ?p ?o } UNION { ?s ?focus ?o } UNION { ?s ?p ?focus }
    }
  }
  FILTER(!isLiteral(?focus))
  FILTER(!isBlank(?focus))
  FILTER(!STRSTARTS(STR(?focus), "http://www.w3.org/"))
  FILTER NOT EXISTS { ?focus skos:prefLabel|rdfs:label [] }
  # An ontology's own (or an imported ontology's) owl:versionIRI is a
  # self-identifying reference, not a "real" resource that needs its own
  # label -- same reasoning as DAT-002's exemption for the identical
  # pattern.
  FILTER NOT EXISTS { [] owl:versionIRI ?focus }
  # rdfs:seeAlso commonly points at a plain external web page (not
  # necessarily RDF at all), which was never meant to carry a label either.
  FILTER NOT EXISTS { [] rdfs:seeAlso ?focus }
  BIND(CONCAT("Resource ", STR(?focus), " has no skos:prefLabel or rdfs:label.") AS ?msg)
}

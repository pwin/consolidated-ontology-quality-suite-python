PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# LOG-001: Class disjoint with its own ancestor
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?c ;
    # The path is what `?anc` was reached by. Emitted so this formulation
    # and its SHACL twin (shapes/logical.ttl's `sh:path [ sh:oneOrMorePath
    # rdfs:subClassOf ]`) produce the same dedup key in checks/merge.py --
    # without it, the identical finding came back as two rows under
    # `--engine both`, one with a path and one without.
    sh:resultPath [ sh:oneOrMorePath rdfs:subClassOf ] ;
    sh:value ?anc ;
    sh:sourceConstraintComponent oq:LOG-001 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?c rdfs:subClassOf+ ?anc .
  ?c owl:disjointWith ?anc .
  BIND(CONCAT("Class ", STR(?c), " is asserted disjoint with its own (transitive) superclass ",
              STR(?anc), ", which makes ", STR(?c), " logically unsatisfiable.") AS ?msg)
}

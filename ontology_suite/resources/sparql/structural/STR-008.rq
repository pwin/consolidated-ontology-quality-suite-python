PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STR-008: Property range value has no declared type
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?focus ;
    sh:resultPath rdfs:range ;
    sh:value ?range ;
    sh:sourceConstraintComponent oq:STR-008 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?focus rdfs:range ?range ;
    a owl:ObjectProperty .
  FILTER NOT EXISTS { ?range a ?class }
  BIND(CONCAT("Object property ", STR(?focus), " declares rdfs:range ", STR(?range),
              " which is never given an rdf:type anywhere in the graph.") AS ?msg)
}

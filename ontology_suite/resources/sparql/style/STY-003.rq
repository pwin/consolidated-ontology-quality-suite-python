PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STY-003: Label missing a language tag
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Info ;
    sh:focusNode ?e ;
    # The offending label itself. The SHACL twin (shapes/style.ttl) selects
    # it as `?value`, so omitting it here left the same finding with two
    # different dedup keys in checks/merge.py -- value=<the label> from the
    # shape, value=<the focus node> from this query via the None->focus
    # normalization -- and both survived as separate rows.
    sh:value ?l ;
    sh:sourceConstraintComponent oq:STY-003 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?e rdfs:label ?l .
  FILTER(LANG(?l) = "")
  # COALESCE, because STR() is defined for literals and IRIs only (SPARQL 1.1
  # 17.4.2.5) and a focus node here is very often a blank node -- an anonymous
  # restriction or axiom carrying an rdfs:label. STR() on one is a type error,
  # which makes CONCAT error, which leaves ?msg unbound, which drops the
  # sh:resultMessage from the result entirely. rdflib does not raise -- it
  # returns the internal blank node id -- so under rdflib alone the message is
  # present but says something meaningless and unstable between runs, and under
  # a conformant engine it vanishes. Measured on examples/checks_stress_test:
  # 60 of 65 results affected, message present under rdflib and absent under
  # both pyoxigraph and HOLOS.
  BIND(COALESCE(STR(?e), "[a blank node]") AS ?focusText)
  BIND(CONCAT("Label '", STR(?l), "' on ", ?focusText,
              " has no language tag; add e.g. @en for internationalisation clarity.") AS ?msg)
}

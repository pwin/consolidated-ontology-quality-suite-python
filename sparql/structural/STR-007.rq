PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STR-007: Predicate has no declared rdf:type
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?focus ;
    sh:value ?s, ?o ;
    sh:sourceConstraintComponent oq:STR-007 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?s ?focus ?o .
  FILTER(!STRSTARTS(STR(?focus), "http://www.w3.org/"))
  FILTER NOT EXISTS { ?focus a ?type }
  BIND(CONCAT("Predicate ", STR(?focus), " is used (e.g. on ", STR(?s),
              ") but is never given an rdf:type anywhere in the graph.") AS ?msg)
}

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STR-005: Property domain value has no declared type
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?focus ;
    sh:resultPath rdfs:domain ;
    sh:value ?domain ;
    sh:sourceConstraintComponent oq:STR-005 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?focus rdfs:domain ?domain .
  FILTER NOT EXISTS { ?domain a ?class }
  BIND(CONCAT("Property ", STR(?focus), " declares rdfs:domain ", STR(?domain),
              " which is never given an rdf:type anywhere in the graph.") AS ?msg)
}

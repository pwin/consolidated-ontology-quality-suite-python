PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STR-006: Untyped object of a triple
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?focus ;
    sh:resultPath ?p ;
    sh:value ?o ;
    sh:sourceConstraintComponent oq:STR-006 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?focus ?p ?o .
  FILTER(?p NOT IN (owl:imports, owl:versionIRI, rdf:type))
  FILTER(!isLiteral(?o))
  FILTER(!isBlank(?o))
  FILTER(!STRSTARTS(STR(?p), "http://www.w3.org/"))
  FILTER(!STRSTARTS(STR(?o), "http://www.w3.org/"))
  FILTER NOT EXISTS { ?o a ?type }
  BIND(CONCAT("Object ", STR(?o), " of triple (", STR(?focus), " ", STR(?p),
              ") is never given an rdf:type anywhere in the graph.") AS ?msg)
}

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# LOG-005: Property declared inverse of itself
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?focus ;
    sh:resultPath owl:inverseOf ;
    sh:value ?focus ;
    sh:sourceConstraintComponent oq:LOG-005 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?focus owl:inverseOf ?focus .
  BIND(CONCAT("Property ", STR(?focus),
              " is declared owl:inverseOf itself, a degenerate/contradictory inverse axiom.") AS ?msg)
}

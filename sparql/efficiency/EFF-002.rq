PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# EFF-002: Excessive blank-node ratio across the whole graph (> 20%).
# There is no single natural focus node for a graph-wide statistic, so this
# check reports against the synthetic anchor oq:Graph.
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Warning ;
    sh:focusNode oq:Graph ;
    sh:sourceConstraintComponent oq:EFF-002 ;
    sh:resultMessage ?msg .
}
WHERE {
  {
    SELECT (COUNT(?node) AS ?total) (SUM(?isbn) AS ?bnodes)
    WHERE {
      SELECT DISTINCT ?node (IF(isBlank(?node), 1, 0) AS ?isbn)
      WHERE {
        ?s ?p ?o .
        { BIND(?s AS ?node) } UNION { BIND(?o AS ?node) FILTER(isIRI(?o) || isBlank(?o)) }
      }
    }
  }
  FILTER(?total > 0)
  FILTER((?bnodes * 1.0 / ?total) > 0.2)
  BIND(CONCAT("Blank nodes make up ", STR(ROUND((?bnodes * 1000.0) / ?total) / 10.0),
              "% of all graph nodes (> 20%), which can hinder linkability and stable identity.") AS ?msg)
}

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# STY-002: Property local name not lowerCamelCase
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Warning ;
    sh:focusNode ?p ;
    sh:sourceConstraintComponent oq:STY-002 ;
    sh:resultMessage ?msg .
}
WHERE {
  { ?p a owl:ObjectProperty } UNION { ?p a owl:DatatypeProperty }
  FILTER(isIRI(?p))
  BIND(REPLACE(STR(?p), "^.*[#/]", "") AS ?local)
  FILTER(!REGEX(?local, "^[a-z][A-Za-z0-9]*$"))
  BIND(CONCAT("Property local name '", ?local, "' does not follow lowerCamelCase naming style.") AS ?msg)
}

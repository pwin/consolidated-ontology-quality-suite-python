@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.org/demo/> .

# --- Well-formed instance ---------------------------------------------------
ex:rex a ex:Mammal ;
  rdfs:label "Rex"@en ;
  ex:hasBirthDate "2019-05-01"^^xsd:date .

# --- Post-closure logical inconsistency -> REA-001 --------------------------
# ex:Reptile is rdfs:subClassOf ex:Animal AND owl:disjointWith ex:Animal (see
# ontology/domain.ttl, LOG-001). Typing an individual as ex:Reptile means an
# owlrl closure entails it's also an ex:Animal (via subClassOf), which
# contradicts the disjointness axiom -- only visible after reasoning, not from
# the raw triples alone.
ex:zed a ex:Reptile ;
  rdfs:label "Zed"@en .

# --- Instance typed with an undeclared class -> STR-001 --------------------
ex:fido a ex:UndeclaredCreatureType ;
  rdfs:label "Fido"@en .

# --- Undeclared predicate used -> STR-002 -----------------------------------
ex:fido ex:undeclaredPredicate "some value" .

# --- Functional property violated: two distinct birth dates -> LOG-002 -----
ex:rex ex:hasBirthDate "2019-06-15"^^xsd:date .

# --- Deprecated term still used -> QUA-003 ----------------------------------
ex:rex ex:legacyStatus "active" .

# --- Invalid literal lexical form for xsd:date -> DAT-001 -------------------
# Must be explicitly ^^xsd:date -- an untyped/plain literal here (as this
# line originally was) never matches DAT-001's `?dt = xsd:date` branch at
# all, so the check silently never fired despite this comment's claim; a
# real, reproducible bug caught only by directly comparing the pyshacl and
# native SHACL engines' raw findings against this fixture, not by reading
# the check's own SPARQL in isolation.
ex:milo a ex:Mammal ;
  rdfs:label "Milo"@en ;
  ex:hasBirthDate "15/06/2019"^^xsd:date .

# --- Dangling reference: ex:ghostOwner is never described elsewhere -> DAT-002
ex:milo ex:hasOwner ex:ghostOwner .

# --- Duplicate literal values for the same subject/predicate -> DAT-003 -----
# Two genuinely distinct RDF terms (one with a language tag, one without) --
# two byte-identical triples (as this originally was) collapse into a
# single triple when parsed, since an RDF graph is a set: nothing was ever
# actually duplicated for DAT-003 to catch. Caught the same way as the
# DAT-001 fix above -- comparing raw engine output against what the
# fixture's own comment claimed, not by reading the check in isolation.
ex:rex rdfs:comment "A friendly dog." .
ex:rex rdfs:comment "A friendly dog."@en .

# --- High fan-out on one property -> EFF-003 (51 values) -------------------
ex:milo ex:hasTag "tag01" .
ex:milo ex:hasTag "tag02" .
ex:milo ex:hasTag "tag03" .
ex:milo ex:hasTag "tag04" .
ex:milo ex:hasTag "tag05" .
